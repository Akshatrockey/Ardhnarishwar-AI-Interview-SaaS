# ==============================================================================
# Ardhnarishwar AI SaaS - Production & Staging Environment Variables
# ==============================================================================

# Frontend Environment Variables (Vite)
VITE_PLATFORM_NAME="Ardhnarishwar Global Enterprise SaaS"
VITE_API_URL="https://ardhnarishwar-backend-api.onrender.com"
VITE_WS_URL="wss://ardhnarishwar-backend-api.onrender.com"

# Backend Environment Variables (FastAPI)
ENVIRONMENT="production"
SECRET_KEY="replace_with_a_secure_64_character_hex_or_alphanumeric_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# CORS Allowed Origins (Comma-separated list of your production frontend domains)
ALLOWED_ORIGINS="https://your-app.vercel.app,https://your-app.netlify.app,https://ardhnarishwar.onrender.com"

# Optional Cloud Database (MySQL / PostgreSQL / Supabase / Neon / TiDB Cloud Free Tier)
# Example: mysql+pymysql://user:password@gateway.tidbcloud.com:4000/ardhnarishwar?ssl_verify_cert=true
DATABASE_URL=""

# Rate Limiting Parameters
RATE_LIMIT_LOGIN_PER_MINUTE="30"
RATE_LIMIT_API_PER_MINUTE="120"
